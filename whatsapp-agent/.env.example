# ─────────────────────────────────────────────────────────────────────────────
# Sentio Mind — Local WhatsApp Automation Agent Configuration
# Copy to `.env` and fill in values. Never commit .env
# ─────────────────────────────────────────────────────────────────────────────

# Local auth token — protects the agent endpoint.
# Auto-generated on first run if left empty.
WHATSAPP_AGENT_TOKEN=""

# Port the agent listens on (localhost only).
WHATSAPP_AGENT_PORT=7860

# Persistent Chromium profile directory.
# WhatsApp Web session is stored here so you only scan QR once.
# Default: ~/.sentio-whatsapp/chrome-profile
BROWSER_PROFILE_DIR=""

# Allowed CORS origins (comma-separated).
# Default: http://localhost:3000
ALLOWED_ORIGINS="http://localhost:3000"
