# ─────────────────────────────────────────────────────────────────────────────
# Leadwise Partnership Outreach CRM — environment configuration
# Copy this file to `.env.local` and fill in real values. Never commit .env.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# DATABASE_URL is the POOLED connection used by the running app. On Neon/Supabase
# this is the "-pooler" / pgbouncer host — required for serverless (Vercel).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# DIRECT_URL is the DIRECT (non-pooled) connection. Prisma Migrate needs it
# because migrations cannot run over a transaction pooler.
# For a plain local Postgres, set both to the same value.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing secret for session JWTs. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in days
AUTH_SESSION_DAYS="7"

# ── Application ──────────────────────────────────────────────────────────────
# IANA timezone used for "today", follow-up due dates and EOD day boundaries.
APP_TIMEZONE="Asia/Kolkata"

# Public base URL (used for absolute links). Optional in development.
# NEXT_PUBLIC_APP_URL="https://crm.sentiomind.com"

# ── AI (EOD executive summary) ───────────────────────────────────────────────
# Optional. If unset, the CRM still generates a complete EOD using a
# deterministic template — AI only rewrites the narrative sections.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# Which provider the AIService should use: "groq" | "none"
AI_PROVIDER="groq"

# ── Google Drive Automated Backups (₹0 Google Cloud Service Account) ─────────
# ID of the Google Drive folder where automated weekly backups will be uploaded.
# Folder URL: https://drive.google.com/drive/folders/1t0JGqrxFsx8wRmnsYGJXjqQXD47KOJ-7
GOOGLE_DRIVE_BACKUP_FOLDER_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ── WhatsApp EOD delivery (₹0 deep-link approach, no Business API) ───────────
# Owner's WhatsApp number in full international format, digits only.
# Example for India: 919876543210
EOD_WHATSAPP_NUMBER=""

# ── Seed data (only used by `npm run db:seed`) ───────────────────────────────
# Password given to every seeded demo user. Change it after first login.
SEED_PASSWORD="Sentio@123"
SEED_OWNER_NAME="Harsh"
SEED_OWNER_EMAIL="harsh@sentiomind.com"
