# ─────────────────────────────────────────────────────────────────────────────
# Leadwise — Production Environment Configuration Template
# Copy this file to `.env.local` for local development. Never commit `.env.local`.
# For production, set these environment variables in your Vercel Project Dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
# Pooled connection string (Port 6543 / pgbouncer) used at runtime by Next.js serverless functions:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct non-pooled connection string (Port 5432) used for Prisma migrations (prisma migrate deploy):
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Authentication & Security ────────────────────────────────────────────────
# 32+ character random secret used to sign secure session JWT tokens.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Session lifetime in days (default: 7)
AUTH_SESSION_DAYS="7"

# Secret token verifying Vercel Cron invocations for backup and reminder jobs:
CRON_SECRET=""

# ── Application Configuration ────────────────────────────────────────────────
# Primary IANA timezone for timeline, follow-ups, and EOD boundaries:
APP_TIMEZONE="Asia/Kolkata"

# Canonical public base URL of the deployed application:
NEXT_PUBLIC_APP_URL="https://your-leadwise-domain.vercel.app"

# ── AI Lead Intelligence & EOD Briefings (Groq Free Tier) ────────────────────
# Free API key from https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"
AI_PROVIDER="groq"

# ── Disaster Recovery (Google Drive Automated Backups) ────────────────────────
# Google Cloud Service Account credentials with Drive API access:
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# Optional root folder ID in Google Drive (Leave blank to auto-create "Leadwise Backups"):
GOOGLE_DRIVE_BACKUP_FOLDER_ID=""

# ── Executive WhatsApp Reporting (Optional) ──────────────────────────────────
# Target phone number for 1-click WhatsApp deep-link delivery (International format, digits only):
EOD_WHATSAPP_NUMBER=""

# ── Database Seed Configuration (Optional) ───────────────────────────────────
# Used only when running `npm run db:seed` to initialize Owner & TL accounts:
SEED_PASSWORD=""
